<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fillViewport="true"
    tools:context=".auth.PinSetupFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/auth_setup_pin"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_pin_subtitle"
            android:textAlignment="center"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />

        <TextView
            android:id="@+id/tv_pin_display"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_marginTop="48dp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
            tools:text="* * * *" />

        <LinearLayout
            android:id="@+id/layout_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_pin_display">

            <TextView
                android:id="@+id/dot_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />

            <TextView
                android:id="@+id/dot_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />

            <TextView
                android:id="@+id/dot_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />

            <TextView
                android:id="@+id/dot_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:background="@drawable/pin_dot_empty" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/error_red"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_pin_dots"
            tools:text="Invalid PIN"
            tools:visibility="visible" />

        <GridLayout
            android:id="@+id/layout_keypad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_error">

            <Button
                android:id="@+id/btn_1"
                style="@style/PinKeyButton"
                android:text="1" />

            <Button
                android:id="@+id/btn_2"
                style="@style/PinKeyButton"
                android:text="2" />

            <Button
                android:id="@+id/btn_3"
                style="@style/PinKeyButton"
                android:text="3" />

            <Button
                android:id="@+id/btn_4"
                style="@style/PinKeyButton"
                android:text="4" />

            <Button
                android:id="@+id/btn_5"
                style="@style/PinKeyButton"
                android:text="5" />

            <Button
                android:id="@+id/btn_6"
                style="@style/PinKeyButton"
                android:text="6" />

            <Button
                android:id="@+id/btn_7"
                style="@style/PinKeyButton"
                android:text="7" />

            <Button
                android:id="@+id/btn_8"
                style="@style/PinKeyButton"
                android:text="8" />

            <Button
                android:id="@+id/btn_9"
                style="@style/PinKeyButton"
                android:text="9" />

            <Button
                android:id="@+id/btn_clear"
                style="@style/PinKeyButton"
                android:text="C" />

            <Button
                android:id="@+id/btn_0"
                style="@style/PinKeyButton"
                android:text="0" />

            <Button
                android:id="@+id/btn_backspace"
                style="@style/PinKeyButton"
                android:text="&lt;" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
